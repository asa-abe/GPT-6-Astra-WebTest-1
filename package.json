{
  "name": "aether-experience",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "build": "astro check && astro build && node scripts/verify-build.mjs",
    "build:production": "SITE_MODE=production pnpm build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/generate-assets.mjs",
    "poster": "node scripts/capture-poster.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "astro": "7.3.5",
    "gsap": "3.15.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/three": "0.186.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
